# Product / installation
APP_NAME=Review Intelligence Platform
APP_ENV=production
APP_PORT=8000
APP_TIMEZONE=UTC

# Security - installer generates ADMIN_PASSWORD_HASH and SECRET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SECRET_KEY=

# Database - installer generates a random password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=review_platform
POSTGRES_USER=review_platform
POSTGRES_PASSWORD=

# Vector database
QDRANT_URL=http://qdrant:6333

# Local AI runtime
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen3:4b

# Google Business Profile - disabled until configured
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback
GOOGLE_ACCESS_TOKEN=
GOOGLE_ACCOUNT_ID=

# Safety defaults
AUTO_PUBLISH_ENABLED=false
AUTOMATION_PAUSED=true
POLL_INTERVAL_MINUTES=10
DAILY_PUBLISH_LIMIT=25

LOG_LEVEL=INFO
